# /etc/tika-mcp/tika-mcp.env
# Override defaults for the tika-mcp systemd service.
# After editing, reload with: sudo systemctl restart tika-mcp

# Apache Tika server URL
TIKA_URL=http://127.0.0.1:9998

# Transport mode: http or stdio
MCP_TRANSPORT=http

# Listen address for HTTP transport
MCP_ADDR=:8080
